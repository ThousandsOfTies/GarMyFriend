[Unit]
Description=GarMyFriend physical face and KY-040 input
After=systemd-udev-trigger.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=garmyfriend
SupplementaryGroups=gpio spi
WorkingDirectory=/opt/garmyfriend/app
Environment=GAR_HARDWARE_DIR=/opt/garmyfriend/app/hardware/orangepi-zero2w
ExecStartPre=/usr/bin/python3 infra/orangepi-zero2w/preflight.py
ExecStart=/opt/garmyfriend/node/bin/node scripts/run-face.cjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=192M

[Install]
WantedBy=multi-user.target

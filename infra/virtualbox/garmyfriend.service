[Unit]
Description=GarMyFriend face application
After=garmyfriend-devices.service
Requires=garmyfriend-devices.service
ConditionPathExists=/home/gar/GarMyFriend-OrangePiZero2W/scripts/run-face.cjs

[Service]
Type=simple
User=gar
WorkingDirectory=/home/gar/GarMyFriend-OrangePiZero2W
ExecStart=/usr/bin/node scripts/run-face.cjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target

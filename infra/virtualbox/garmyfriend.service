[Unit]
Description=GarMyFriend face application
After=garmyfriend-devices.service
Requires=garmyfriend-devices.service
ConditionPathExists=/home/gar/GarMyFriend/application/face.cjs

[Service]
Type=simple
User=gar
WorkingDirectory=/home/gar/GarMyFriend
ExecStart=/usr/bin/node application/face.cjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=128M

[Install]
WantedBy=multi-user.target

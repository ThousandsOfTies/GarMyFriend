[Unit]
Description=GarMyFriend development HTTPS tunnel
After=network-online.target garmyfriend-panel.service
Wants=network-online.target

[Service]
Type=simple
User=gar
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8773
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

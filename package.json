{
  "name": "gar-my-friend",
  "version": "0.2.0",
  "private": true,
  "description": "Orange Pi Zero 2W robot simulation with GAR device components",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build-preview.cjs",
    "test": "node --test tests/runtime.cjs && node tests/preview.cjs && node tests/simulator.cjs",
    "test:runtime": "node --test tests/runtime.cjs",
    "test:preview": "node tests/preview.cjs",
    "test:simulator": "node tests/simulator.cjs",
    "vm:start": "python tools/vm.py start",
    "vm:stop": "python tools/vm.py stop",
    "vm:status": "python tools/vm.py status",
    "vm:deploy": "python tools/vm.py deploy",
    "vm:publish": "python tools/vm.py publish",
    "vm:open": "python tools/vm.py open",
    "sim": "python tools/vm.py open",
    "dev": "node tools/simulator.cjs start",
    "sim:open": "python tools/vm.py open",
    "sim:stop": "python tools/vm.py stop",
    "sim:status": "python tools/vm.py status",
    "sim:command": "node tools/send-command.cjs",
    "test:vm": "node tests/vm-panel.cjs",
    "dev:open": "node tools/simulator.cjs start --open",
    "dev:stop": "node tools/simulator.cjs stop",
    "dev:restart": "node tools/simulator.cjs restart",
    "dev:status": "node tools/simulator.cjs status"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
